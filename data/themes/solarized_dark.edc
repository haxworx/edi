data {
    item: "title" "Solarized Dark";
}

collections {

/* simple layout to pack our scrolling content into an elm_layout */
group { name: "elm/code/layout/default";
   data {
      item: "font.name" "Mono";
      item: "font.size" "10";
   }
   parts {
      part { name: "elm.swallow.content"; type: SWALLOW;
         description { state: "default" 0.0;
            align: 0.5 0.0;
            fixed: 0 1;

            rel2 {
               relative: 1.0 1.0;
               offset: 0 0;
            }
         }
      }
   }
}

color_classes {
    color_class { name: "/fg/normal/text"; color: 88 110 117 255; }
    color_class { name: "/fg/normal/text-code"; color: 147 161 161 255; }
    color_class { name: "/fg/normal/text-comment"; color: 88 110 117 255; }
    color_class { name: "/fg/normal/text-string"; color: 42 161 152 255; }
    color_class { name: "/fg/normal/text-number"; color: 42 161 152 255; }
    color_class { name: "/fg/normal/text-brace"; color: 131 148 150 255; }
    color_class { name: "/fg/normal/text-type"; color: 181 137 0 255; }
    color_class { name: "/fg/normal/text-class"; color: 255 255 255 255; }
    color_class { name: "/fg/normal/text-function"; color: 255 255 255 255; }
    color_class { name: "/fg/normal/text-param"; color: 181 137 0 255; }
    color_class { name: "/fg/normal/text-keyword"; color: 181 137 0 255; }
    color_class { name: "/fg/normal/text-preprocessor"; color: 203 75 22 255; }
    color_class { name: "/fg/normal/text-line-added"; color: 54 255 54 255; }
    color_class { name: "/fg/normal/text-line-removed"; color: 255 54 54 255; }
    color_class { name: "/fg/normal/text-line-changed"; color: 54 54 255 255; }
    color_class { name: "/fg/normal/text-status"; color: 0 43 54 255; }
    color_class { name: "/fg/normal/text-match"; color: 187 187 51 255; }
    color_class { name: "/fg/normal/text-current"; color: 7 54 66 255; }
    color_class { name: "/fg/normal/text-ignored"; color: 36 36 36 255; }
    color_class { name: "/fg/normal/text-note"; color: 221 119 17 255; }
    color_class { name: "/fg/normal/text-warning"; color: 221 119 17 255; }
    color_class { name: "/fg/normal/text-error"; color: 204 17 17 255; }
    color_class { name: "/fg/normal/text-fatal"; color: 204 17 17 255; }
    color_class { name: "/fg/normal/text-success"; color: 54 96 54 255; }
    color_class { name: "/fg/normal/text-failure"; color: 96 54 54 255; }
    color_class { name: "/fg/normal/text-todo"; color: 211 54 130 255; }
    color_class { name: "/fg/normal/text-gutter"; color: 88 110 117 255; }

    color_class { name: "/bg/normal"; color: 7 54 66 255; }
    color_class { name: "/bg/normal/text"; color: 7 54 66 255; }
    color_class { name: "/bg/normal/text-selection"; color: 38 139 210 255; }
    color_class { name: "/bg/normal/text-gutter"; color: 7 54 66 255; }
    color_class { name: "/bg/normal/text-scope"; color: 54 54 54 255; }
    color_class { name: "/bg/normal/text-whitespace"; color: 50 50 50 127; }
}
}
